@model SupportTicketManagement.Web.ViewModels.TicketEditViewModel
@using SupportTicketManagement.Web.Helpers
@{
    ViewData["Title"] = "Edit Ticket";
}

<h1 class="mb-4">Edit Ticket</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label class="form-label">Status</label>
        <input class="form-control" value="@TicketDisplayHelper.FormatStatus(Model.Status)" readonly />
        <div class="form-text">Status cannot be changed on this screen.</div>
    </div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Priority" class="form-label"></label>
        <select asp-for="Priority" asp-items="Model.PriorityOptions" class="form-select"></select>
        <span asp-validation-for="Priority" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="AssignedToId" class="form-label"></label>
        <select asp-for="AssignedToId" asp-items="Model.UserOptions" class="form-select"></select>
        <span asp-validation-for="AssignedToId" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
