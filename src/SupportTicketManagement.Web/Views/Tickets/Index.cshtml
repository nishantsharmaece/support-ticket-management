@using SupportTicketManagement.Web.Helpers
@model SupportTicketManagement.Web.ViewModels.TicketListViewModel
@{
    ViewData["Title"] = "Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Tickets</h1>
    <a asp-action="Create" class="btn btn-primary">Create Ticket</a>
</div>

<form asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-5">
        <label asp-for="Search" class="form-label">Search</label>
        <input asp-for="Search" class="form-control" placeholder="Search title or description" />
    </div>
    <div class="col-md-4">
        <label asp-for="StatusFilter" class="form-label">Status</label>
        <select asp-for="StatusFilter" asp-items="Model.StatusOptions" class="form-select"></select>
        <span asp-validation-for="StatusFilter" class="text-danger"></span>
    </div>
    <div class="col-md-3 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-outline-primary">Apply</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

@if (Model.Tickets.Count == 0)
{
    <div class="alert alert-info">
        @if (Model.HasActiveFilters)
        {
            <span>No tickets match your search or filter criteria.</span>
        }
        else
        {
            <span>No tickets found. Create your first ticket to get started.</span>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Assignee</th>
                    <th>Updated</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ticket in Model.Tickets)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@ticket.Id" class="text-decoration-none fw-semibold">
                                @ticket.Title
                            </a>
                        </td>
                        <td>
                            <span class="badge @TicketDisplayHelper.StatusBadgeClass(ticket.Status)">
                                @TicketDisplayHelper.FormatStatus(ticket.Status)
                            </span>
                        </td>
                        <td>
                            <span class="badge @TicketDisplayHelper.PriorityBadgeClass(ticket.Priority)">
                                @ticket.Priority
                            </span>
                        </td>
                        <td>@ticket.AssigneeName</td>
                        <td>@TicketDisplayHelper.FormatTimestamp(ticket.UpdatedAt)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
